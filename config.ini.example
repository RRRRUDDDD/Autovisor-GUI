[user-account]
;配置账号密码，留空则打开网页后需手动登录
;留空时首次运行会在终端引导输入一次并自动保存到本文件, 之后即可全自动登录
username =
password =

[browser-option]
;配置浏览器,可选 Edge 或 Chrome
driver = Edge
;指定浏览器所在路径,不填则使用默认路径
EXE_PATH =

[script-option]
;是否自动过验证码(登录滑块 / 课中点选, 默认:True)
enableAutoCaptcha = True
;可选: 使用 DeepSeek 处理课中单点点击验证，需要单独配置 API Key
enableVisionCaptcha = False
;仅填写在本地配置中，不要提交包含真实 Key 的文件
deepseekApiKey =
;是否自动隐藏浏览器窗口(默认:False)
enableHideWindow = False
;是否展示赞赏码(默认:True)
showDonateCode = True

[course-option]
;限制每门课程刷课时长/min (不限制:0)
limitMaxTime = 30
;限定播放倍速 (最高:1.8)
limitSpeed = 1.0
;设置是否静音播放 (默认:True)
soundOff = True
;AI智慧课: 视频刷完后是否继续把知识点掌握度(题目)刷满 (默认:True)
enableMastery = True
;掌握度目标百分比 (1-100, 默认:100)
masteryTarget = 100

[course-url]
;配置要学习的课程链接,支持智慧共享课、翻转课、融合共享课、AI慕课(wisdom-mooc)、AI智慧课
;AI智慧课直接填 singleCourse/knowledgeStudy 或 learnPage 地址即可, 会自动先刷视频再刷掌握度
;可继续添加多个课程链接
URL1 =
URL2 =
URL3 =
URL4 =
URLn =
