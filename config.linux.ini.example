[user-account]
;配置账号密码，留空则打开网页后需手动登录
username =
password =
;可选: 启用终端二维码登录(适合无头 / SSH 环境)
qrLogin = False
qrTerminal = False
qrUnicode = False
qrSaveDir =

[browser-option]
;Linux 默认使用 Playwright 自带的 Chromium
;首次运行前执行 uv run playwright install chromium
driver = chromium
;指定浏览器所在路径，留空则使用 Playwright 自带的 Chromium
EXE_PATH =
;可选: 配置代理服务器(支持 http:// / https:// / socks5://)
proxy =

[script-option]
;是否自动过验证码(登录滑块 / 课中点选, 默认:True)
enableAutoCaptcha = True
;是否自动隐藏浏览器窗口(默认:False)，Linux 下无效
enableHideWindow = False
;刷课任务完成后自动关机(默认:False)
shutdownOnComplete = False
;单份日志体积上限/MB, 超限自动切换到下一个日志文件 (默认:10)
log_max_size_mb = 10
;日志保留天数, 启动时清理超期文件 (默认:14, 0=不按天清理)
log_retention_days = 14
;日志文件数上限(含 .txt.gz), 超出后从旧到新删除 (默认:200)
log_max_files = 200
;超过该天数的日志启动时 gzip 压缩归档 (默认:3, 0=不压缩)
log_compress_after_days = 3

[notification]
;可选: 远程消息推送(ServerChan / Qmsg / Bark / Telegram)
provider =
url =
tg_chat_id =
notifyOnVerify = True
notifyOnFinish = True
notifyOnError = True

[course-option]
;限制每门课程刷课时长/min (不限制:0)
limitMaxTime = 0
;限定播放倍速 (最高:1.8)
limitSpeed = 1.0
;设置是否静音播放 (默认:True)
soundOff = True
;复习模式/刷习惯分: 忽略已完成状态重播视频, 设置 limitMaxTime 时循环刷满时长 (默认:False)
reviewMode = False
;AI智慧课: 是否先用接口版 ExamCtx 刷计分考试并交卷 (默认:True)
enableExamApi = True
;AI智慧课: 视频刷完后是否继续把知识点掌握度(题目)刷满 (默认:True)
enableMastery = True
;复习/模拟考试页: 是否捕获新页面并用接口直接作答交卷 (默认:False, 正式考试勿开)
enableReviewExamApi = False
;课中弹题: 是否优先用智慧树 AI 作答, 失败回退自定义大模型 (默认:True)
enableZhidaoQuiz = True
;播放页: 只读拦截课中弹题接口, 直接取服务端正确答案 (默认:True)
enablePopupIntercept = True
;知到作业: 命中作业页时优先走加密 API 明文作答, 失败回退视觉模型 (默认:True)
enableHomeworkApi = True
;知到作业达标得分率 0-100, 低于该值自动重做 (默认:100)
homeworkThreshold = 100
;知到作业单份最大重做次数 (默认:3, 0=使用默认轮次)
homeworkMaxRedo = 3
;知到正式考试: 命中考试页时由加密 API 接管, 交卷受 data/llm.json 的 auto_submit 控制 (默认:True)
enableFormalExamApi = True
;AI智慧课: 自动提取知识点 PPT 课件文本作为答题参考 (默认:True)
enablePptReference = True
;掌握度目标百分比 (1-100, 默认:100)
masteryTarget = 100

[course-url]
;配置要学习的课程链接,支持(智慧)共享课
;可继续添加多个课程链接
URL1 =
URL2 =
URL3 =
URL4 =
URLn =
