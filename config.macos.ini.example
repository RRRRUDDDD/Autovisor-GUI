[user-account]
;配置账号密码，留空则打开网页后需手动登录
;留空时首次运行会在终端引导输入一次并自动保存到本文件, 之后即可全自动登录
username =
password =
;可选: 启用终端二维码登录(默认:False)
qrLogin = False
qrTerminal = False
qrUnicode = False
qrSaveDir =

[browser-option]
;macOS 默认启动独立 Chrome，EXE_PATH 通常留空
driver = Chrome
EXE_PATH =
;可选: 配置代理服务器(支持 http:// / https:// / socks5://)
proxy =
;实验性：连接已开启远程调试的日常 Chrome
attachExistingChrome = False
cdpUrl = http://127.0.0.1:9222

[script-option]
;是否自动过验证码(登录滑块[易盾/腾讯] / 课中点选)
enableAutoCaptcha = False
enableHideWindow = False
;刷课任务完成后自动关机(默认:False)
shutdownOnComplete = False
;单个日志文件体积上限/MB, 超过后轮转 (默认:10)
log_max_size_mb = 10
;日志保留天数, 过期归档清理 (默认:14)
log_retention_days = 14
;日志文件最大保留数量 (默认:200)
log_max_files = 200
;日志归档多少天后压缩 (默认:3)
log_compress_after_days = 3

[notification]
;可选: 远程消息推送(ServerChan / Qmsg / Bark / Telegram)
provider =
url =
tg_chat_id =
notifyOnVerify = True
notifyOnFinish = True
notifyOnError = True

[course-option]
;限制每门课程运行时长/min (不限制:0)
limitMaxTime = 0
limitSpeed = 1.0
soundOff = True
;复习模式/刷习惯分: 忽略已完成状态重播视频, 设置 limitMaxTime 时循环刷满时长 (默认:False)
reviewMode = False
;AI智慧课: 是否先用接口版 ExamCtx 刷计分考试并交卷 (默认:True)
enableExamApi = True
;复习/模拟考试页: 是否捕获新页面并用接口直接作答交卷 (默认:False, 正式考试勿开)
enableReviewExamApi = False
;课中弹题: 是否优先用智慧树 AI 作答, 失败回退自定义大模型 (默认:True)
enableZhidaoQuiz = True
;弹题响应监听: 只读捕获官方 AI 答案, 未命中回退大模型 (默认:True)
enablePopupIntercept = True
;知到作业: 是否自动刷作业并按目标分重做错题 (默认:True)
enableHomeworkApi = True
;作业目标分 (0-100, 默认:100)
homeworkThreshold = 100
;作业错题重做最大轮数 (默认:3)
homeworkMaxRedo = 3
;正式考试: 是否用接口自动作答交卷, 交卷受 llm.json 的 auto_submit 控制 (默认:True)
enableFormalExamApi = True
;考试参考资料: 自动抓取课程知识点 PPT 作为答题参考 (默认:True)
enablePptReference = True
;掌握度目标(%), 仅开启掌握度模式时生效 (默认:85)
enableMastery = True
masteryTarget = 85

[course-url]
URL1 =
URL2 =
URL3 =
URL4 =
URLn =
